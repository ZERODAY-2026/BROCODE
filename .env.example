# =============================================================================
# DataMind — Talk to Your Data | Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file with real credentials.
# =============================================================================

# --- Snowflake Configuration ---
SNOWFLAKE_ACCOUNT=your_account_identifier        # e.g., abc12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password                  # Use key-pair auth in production
SNOWFLAKE_WAREHOUSE=your_warehouse                # e.g., COMPUTE_WH
SNOWFLAKE_DATABASE=your_database                  # e.g., DATAMIND_DB
SNOWFLAKE_SCHEMA=your_schema                      # e.g., PUBLIC
SNOWFLAKE_ROLE=your_role                          # e.g., DATAMIND_READER (read-only role)

# --- Gemma Configuration ---
GEMMA_PROVIDER=ollama                             # ollama | api
GEMMA_MODEL=gemma3:4b                             # Model name in Ollama
GEMMA_API_BASE=http://localhost:11434             # Ollama API endpoint
GEMMA_TIMEOUT=120                                 # Timeout in seconds for Gemma calls

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173                # Comma-separated frontend origins

# --- Query Safety ---
MAX_RESULT_ROWS=1000                              # Maximum rows returned per query
QUERY_TIMEOUT_SECONDS=30                          # Snowflake query timeout
ALLOWED_DATABASES=                                # Comma-separated; empty = use SNOWFLAKE_DATABASE
ALLOWED_SCHEMAS=                                  # Comma-separated; empty = use SNOWFLAKE_SCHEMA
